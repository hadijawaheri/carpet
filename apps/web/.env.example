# Copy to .env.local. Server-side only: where Next rewrites /api/* and where Server Components fetch.
# Baked into the rewrites at build time; read again at runtime by Server Components and proxy.ts.
INTERNAL_API_URL=http://localhost:7781

# Optional error reporting. SENTRY_DSN is read by the server at runtime; NEXT_PUBLIC_SENTRY_DSN is
# baked into the browser bundle at build time. Empty sends nothing.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, at build time only: upload source maps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
