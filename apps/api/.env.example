NODE_ENV=development
PORT=7781
HOST=127.0.0.1
# infra/docker-compose.yml starts a single-node replica set on this port. farsh_app can only touch
# the farsh database; use MONGO_APP_PASSWORD from infra/.env
DATABASE_URL=mongodb://farsh_app:CHANGE_ME@127.0.0.1:27018/farsh?replicaSet=rs0&authSource=farsh

# generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=

CORS_ORIGINS=http://localhost:7782

# console prints the OTP in dev; both are forbidden in production
SMS_PROVIDER=console
OTP_FIXED_CODE=
# melipayamak: API key from console.melipayamak.com and the id of an approved pattern with one {0} for the code
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_BODY_ID=
THROTTLE_ENABLED=true
