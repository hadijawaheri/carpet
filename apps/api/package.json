{
  "name": "@farsh/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "nest build && node dist/cli/seed.js",
    "db:indexes": "node dist/cli/seed.js --indexes-only",
    "db:migrate": "migrate-mongo up",
    "db:migrate:status": "migrate-mongo status",
    "db:migrate:create": "migrate-mongo create"
  },
  "dependencies": {
    "@farsh/contracts": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@sentry/nestjs": "11.8.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "migrate-mongo": "14.0.7",
    "mongodb": "~7.7.0",
    "mongoose": "^9.11.2",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/migrate-mongo": "14.0.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  }
}
